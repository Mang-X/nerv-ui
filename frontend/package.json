{
  "name": "@nerv-iip/frontend-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @nerv-iip/playground dev",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "build": "pnpm typecheck && pnpm --filter @nerv-iip/playground build",
    "fmt": "vp fmt --check .",
    "fmt:fix": "vp fmt --write .",
    "lint": "vp lint .",
    "docs:dev": "pnpm --filter @nerv-iip/docs dev",
    "docs:build": "pnpm --filter @nerv-iip/docs build",
    "docs:typecheck": "pnpm --filter @nerv-iip/docs typecheck"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "26.1.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@voidzero-dev/vite-plus-core": "0.2.4",
    "@vue/test-utils": "2.4.11",
    "jsdom": "29.1.1",
    "shadcn-vue": "^2.7.4",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4",
    "vite-plugin-wasm": "3.6.0",
    "vite-plus": "0.2.4",
    "vitest": "4.1.10",
    "vue-router": "5.2.0",
    "vue-tsc": "3.3.7"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.22.0"
}
