    "reka-ui": "^2.10.1"
  },
  "devDependencies": {
    "@tsdown/css": "^0.23.7",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "jsdom": "29.1.1",
    "tsdown": "0.23.7",
    "unplugin-vue": "^8.0.1",
    "vitest": "4.1.10"
  }
