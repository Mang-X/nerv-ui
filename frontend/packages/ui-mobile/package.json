{
  "name": "@nerv-iip/ui-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/style.css",
    "./styles/mobile.css": "./src/styles/mobile.css"
