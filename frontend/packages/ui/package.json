{
  "name": "@nerv-iip/ui",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./desktop": {
      "types": "./dist/desktop.d.ts",
      "import": "./dist/desktop.js"
    },
    "./screen": {
      "types": "./dist/screen.d.ts",
      "import": "./dist/screen.js"
    },
    "./pad": {
      "types": "./dist/pad.d.ts",
      "import": "./dist/pad.js"
    },
    "./file-preview": {
      "types": "./dist/file-preview.d.ts",
      "import": "./dist/file-preview.js"
    },
    "./test-support": {
      "types": "./dist/test-support.d.ts",
      "import": "./dist/test-support.js"
    },
    "./styles.css": "./src/styles/standalone.css",
    "./theme.css": "./src/styles/theme.css",
    "./overrides.css": "./src/styles/overrides.css"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vp test run src --exclude src/design-docs.contract.test.ts --exclude src/nvui-doc-coverage.contract.test.ts --exclude src/docs-layout.contract.test.ts",
    "test:docs": "vp test run src/design-docs.contract.test.ts src/nvui-doc-coverage.contract.test.ts src/docs-layout.contract.test.ts"
  },
  "dependencies": {
    "@embedpdf/core": "2.14.4",
    "@embedpdf/engines": "2.14.4",
    "@embedpdf/plugin-document-manager": "2.14.4",
    "@embedpdf/plugin-render": "2.14.4",
    "@embedpdf/plugin-scroll": "2.14.4",
    "@embedpdf/plugin-viewport": "2.14.4",
    "@embedpdf/plugin-zoom": "2.14.4",
    "@fontsource-variable/inter": "^5.2.8",
    "@internationalized/date": "^3.12.2",
    "@lucide/vue": "1.24.0",
    "@silurus/ooxml": "0.72.2",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion-v": "2.3.0",
    "tailwind-merge": "^3.6.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tsdown/css": "^0.23.7",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "jsdom": "29.1.1",
    "tsdown": "0.23.7",
    "unplugin-vue": "^8.0.1",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "reka-ui": "^2.10.1",
    "vue": "^3.5.0"
  }
}
